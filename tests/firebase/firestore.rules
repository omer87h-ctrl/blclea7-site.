rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Minimal developer fixture: a public profile contains deliberately public fields only.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'bio'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 1000;
      allow delete: if owner(uid);
    }
    match /private/{uid} {
      allow get, create, update, delete: if owner(uid);
      allow list: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
