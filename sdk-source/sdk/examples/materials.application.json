{
  "format": "clea7.application/4",
  "id": "sdk_materials",
  "name": "Moj lokalni prostor",
  "package": "com.brzoilokalno.sdk.materials",
  "version": 1,
  "start": "home",
  "permissions": [],
  "state": {
    "material_95992499b234d4f03aabfc7ebd896ea2_draft": "",
    "material_95992499b234d4f03aabfc7ebd896ea2_record": {},
    "material_95992499b234d4f03aabfc7ebd896ea2_rows": []
  },
  "screens": [
    {
      "id": "home",
      "name": "Početni ekran",
      "children": [
        {
          "id": "material_95992499b234d4f03aabfc7ebd896ea2_root",
          "type": "card",
          "style": {
            "background": "#162534",
            "color": "#f2f6fa",
            "padding": 20,
            "radius": 18,
            "gap": 14
          },
          "children": [
            {
              "id": "material_95992499b234d4f03aabfc7ebd896ea2_title",
              "type": "heading",
              "text": "Zapisi koji ostaju kod tebe",
              "style": {
                "color": "#f2f6fa",
                "fontSize": 26,
                "fontWeight": 800
              }
            },
            {
              "id": "material_95992499b234d4f03aabfc7ebd896ea2_draft_input",
              "type": "input",
              "label": "Naziv novog zapisa",
              "bind": "material_95992499b234d4f03aabfc7ebd896ea2_draft"
            },
            {
              "id": "material_95992499b234d4f03aabfc7ebd896ea2_controls",
              "type": "row",
              "style": {
                "gap": 10,
                "wrap": true
              },
              "children": [
                {
                  "id": "material_95992499b234d4f03aabfc7ebd896ea2_add",
                  "type": "button",
                  "text": "Dodaj zapis",
                  "events": {
                    "click": "material_95992499b234d4f03aabfc7ebd896ea2_add"
                  },
                  "style": {
                    "background": "#ffb27f",
                    "color": "#17202a",
                    "radius": 12,
                    "padding": 12,
                    "fontWeight": 700
                  },
                  "review": true
                },
                {
                  "id": "material_95992499b234d4f03aabfc7ebd896ea2_refresh",
                  "type": "button",
                  "text": "Osvježi",
                  "events": {
                    "click": "material_95992499b234d4f03aabfc7ebd896ea2_refresh"
                  },
                  "style": {
                    "background": "#ffb27f",
                    "color": "#17202a",
                    "radius": 12,
                    "padding": 12,
                    "fontWeight": 700
                  }
                }
              ]
            },
            {
              "id": "material_95992499b234d4f03aabfc7ebd896ea2_list",
              "type": "list",
              "bind": "material_95992499b234d4f03aabfc7ebd896ea2_rows",
              "children": [
                {
                  "id": "material_95992499b234d4f03aabfc7ebd896ea2_entry",
                  "type": "card",
                  "children": [
                    {
                      "id": "material_95992499b234d4f03aabfc7ebd896ea2_entry_title",
                      "type": "text",
                      "text": {
                        "op": "field",
                        "args": [
                          {
                            "op": "field",
                            "args": [
                              {
                                "ref": "item",
                                "key": "value"
                              },
                              "data"
                            ]
                          },
                          "title"
                        ]
                      },
                      "style": {
                        "color": "#bdd0df",
                        "fontSize": 16
                      }
                    },
                    {
                      "id": "material_95992499b234d4f03aabfc7ebd896ea2_remove",
                      "type": "button",
                      "text": "Obriši ovaj zapis",
                      "events": {
                        "click": "material_95992499b234d4f03aabfc7ebd896ea2_remove"
                      },
                      "style": {
                        "background": "#ffb27f",
                        "color": "#17202a",
                        "radius": 12,
                        "padding": 12,
                        "fontWeight": 700
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "flows": {
    "material_95992499b234d4f03aabfc7ebd896ea2_add": [
      {
        "action": "if",
        "condition": {
          "op": "greater",
          "args": [
            {
              "op": "length",
              "args": [
                {
                  "ref": "state",
                  "key": "material_95992499b234d4f03aabfc7ebd896ea2_draft"
                }
              ]
            },
            0
          ]
        },
        "then": [
          {
            "action": "record.create",
            "table": "material_95992499b234d4f03aabfc7ebd896ea2_entries",
            "key": "material_95992499b234d4f03aabfc7ebd896ea2_record",
            "value": {
              "title": {
                "ref": "state",
                "key": "material_95992499b234d4f03aabfc7ebd896ea2_draft"
              }
            }
          },
          {
            "action": "set",
            "key": "material_95992499b234d4f03aabfc7ebd896ea2_draft",
            "value": ""
          },
          {
            "action": "record.query",
            "table": "material_95992499b234d4f03aabfc7ebd896ea2_entries",
            "key": "material_95992499b234d4f03aabfc7ebd896ea2_rows",
            "where": {},
            "limit": 100
          }
        ],
        "else": [
          {
            "action": "notify",
            "value": "Unesi naziv zapisa."
          }
        ]
      }
    ],
    "material_95992499b234d4f03aabfc7ebd896ea2_refresh": [
      {
        "action": "record.query",
        "table": "material_95992499b234d4f03aabfc7ebd896ea2_entries",
        "key": "material_95992499b234d4f03aabfc7ebd896ea2_rows",
        "where": {},
        "limit": 100
      }
    ],
    "material_95992499b234d4f03aabfc7ebd896ea2_remove": [
      {
        "action": "record.delete",
        "table": "material_95992499b234d4f03aabfc7ebd896ea2_entries",
        "key": "material_95992499b234d4f03aabfc7ebd896ea2_record",
        "id": {
          "op": "field",
          "args": [
            {
              "ref": "item",
              "key": "value"
